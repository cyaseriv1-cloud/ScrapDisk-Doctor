<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila superior: Veredicto y Fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemVerdict"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🟢 COMPRA SEGURA"
            android:textColor="@color/status_good"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:50 - 19 Sep"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Etiqueta del disco (si fue etiquetado) -->
    <TextView
        android:id="@+id/tvItemLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="🏷️ Disco #1 - Toshiba 1TB"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Información de Ganga / Precio -->
    <TextView
        android:id="@+id/tvItemBargain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="💎 Ganga: $15 por 1TB ($0.015/GB)"
        android:textColor="@color/status_good"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Tipo de unidad y latencia -->
    <TextView
        android:id="@+id/tvItemDriveType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="💽 HDD Mecánico | Latencia: 14 ms"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Detalles de velocidad -->
    <TextView
        android:id="@+id/tvItemDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Esc: 45.2 MB/s | Lec: 82.1 MB/s | OK"
        android:textColor="@color/text_body"
        android:textSize="12sp" />

</LinearLayout>
