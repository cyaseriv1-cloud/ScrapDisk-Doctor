<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Encabezado con título, audio e historial -->
    <ImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_harddrive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/app_name"
        android:textColor="@color/text_title"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnToggleSound"
        app:layout_constraintStart_toEndOf="@id/ivAppLogo"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edición Desguace Pro (Audio &amp; Latencia)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="@id/tvAppTitle"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <ImageButton
        android:id="@+id/btnToggleSound"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Alternar Audio"
        android:src="@drawable/ic_volume_up"
        app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
        app:layout_constraintEnd_toStartOf="@id/btnOpenHistory"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo"
        app:tint="@color/text_body" />

    <ImageButton
        android:id="@+id/btnOpenHistory"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_history"
        android:src="@drawable/ic_history"
        app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo"
        app:tint="@color/text_body" />

    <!-- Banner de Hardware USB Detectado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUsbHardware"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_card_secondary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvUsbHardwareInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🔌 Buscando adaptador USB-SATA..."
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnRefreshUsb"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Actualizar USB"
                android:src="@drawable/ic_history"
                app:tint="@color/text_muted" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnSelectDrive"
        app:layout_constraintTop_toBottomOf="@id/cardUsbHardware">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta Central Principal de Veredicto / Estado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#24324D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <ImageView
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Estado"
                        android:src="@drawable/ic_harddrive"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvVerdictTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="LISTO PARA PROBAR"
                        android:textColor="@color/text_title"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Badge de Tipo de Disco (HDD vs SSD) -->
                    <TextView
                        android:id="@+id/badgeDriveType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="💽 Almacenamiento"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Velocidad -->
                    <TextView
                        android:id="@+id/tvSpeedResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Velocidad: -- MB/s"
                        android:textColor="@color/status_good"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Latencia y Estado de Sectores -->
                    <TextView
                        android:id="@+id/tvLatencyResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Latencia: --"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvVerdictDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Conecta tu disco por OTG y presiona 'PROBAR DISCO'. El análisis toma 3 segundos."
                        android:textColor="@color/text_body"
                        android:textSize="13sp" />

                    <!-- Barra de progreso con indicador de estado -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/bg_card_secondary"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Probando disco..."
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Botón para Calcular Ganga / Etiquetar Disco (Aparece tras el test) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenBargainDialog"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:text="🏷️ CALCULAR GANGA / ETIQUETAR"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_tag"
                        app:iconSize="16dp"
                        app:iconTint="@color/accent"
                        app:strokeColor="@color/accent" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta Informativa sobre Alertas Sonoras y Desconexión -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/bg_card_secondary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#24324D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊 ALERTAS SONORAS PARA DESGUACE"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• Doble pitido agudo = 🟢 Bueno / Compra Segura.\n• Pitido medio = 🟡 Advertencia / NTFS.\n• Pitido grave continuo = 🔴 Disco Dañado o Trabado.\n• Puedes probar bajo el sol guiándote por el sonido y la vibración."
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Botón Principal Flotante Inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectDrive"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primary"
        android:text="⚡ PROBAR DISCO (TEST RÁPIDO)"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_harddrive"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btnEjectDrive" />

    <!-- Botón Secundario de Expulsión y Reposo Seguro -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjectDrive"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="⏏️ LIBERAR / EXPULSAR DISCO SEGURO"
        android:textColor="@color/text_body"
        android:textSize="13sp"
        app:cornerRadius="14dp"
        app:strokeColor="#334155"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
