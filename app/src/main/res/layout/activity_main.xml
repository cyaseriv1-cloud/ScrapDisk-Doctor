<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="20dp">

    <!-- Encabezado con título e historial -->
    <ImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_harddrive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/app_name"
        android:textColor="@color/text_title"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnOpenHistory"
        app:layout_constraintStart_toEndOf="@id/ivAppLogo"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Test Rápido de 3 Segundos (Anti-Cuelgues)"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="@id/tvAppTitle"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <ImageButton
        android:id="@+id/btnOpenHistory"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_history"
        android:src="@drawable/ic_history"
        app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivAppLogo"
        app:tint="@color/text_body" />

    <!-- Tarjeta Central Principal de Veredicto / Estado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#24324D"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Estado"
                android:src="@drawable/ic_harddrive"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvVerdictTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="LISTO PARA PROBAR"
                android:textColor="@color/text_title"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpeedResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Velocidad: -- MB/s"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVerdictDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Conecta el disco duro por OTG y presiona el botón inferior para diagnosticarlo."
                android:textColor="@color/text_body"
                android:textSize="14sp" />

            <!-- Barra de progreso con indicador de estado -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/bg_card_secondary"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Probando disco..."
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta de Instrucciones Rápidas -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/bg_card_secondary"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#24324D"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ CÓMO FUNCIONA EL TEST RÁPIDO"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="1. Toca 'PROBAR DISCO'.\n2. En el menú de Android, pulsa tu disco USB y dale a 'Usar esta carpeta'.\n3. La app escribe y lee 2 MB en 3 segundos con protección anti-bloqueos."
                android:textColor="@color/text_body"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Principal Flotante Inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectDrive"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="@color/primary"
        android:text="⚡ PROBAR DISCO (TEST RÁPIDO)"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_harddrive"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
